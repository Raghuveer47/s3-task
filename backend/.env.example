# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Server
PORT=5050

# Amazon S3
# Use the same region you selected when creating the bucket.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
S3_BUCKET_NAME=your_bucket_name_here

# Amazon RDS (MySQL)
# Use the RDS endpoint from the AWS console, not the IP address.
RDS_HOST=
RDS_PORT=
RDS_DATABASE=
RDS_USERNAME=admin
RDS_PASSWORD=your_rds_password_here
# Set to false only if your classroom RDS instance rejects SSL.
RDS_SSL=true
